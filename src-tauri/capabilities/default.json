{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capability for ide99 S2 — core window, menu, event",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:menu:default",
    "core:event:default",
    "dialog:allow-save",
    "dialog:allow-open"
  ]
}
